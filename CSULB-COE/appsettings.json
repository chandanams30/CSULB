{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "AllowedHosts": "*",
  "JWT": {
    "Key": "This is my supper secret key for jwt",
    "Issuer": "http://CSULB.com",
    "Audience": "http://CSULB.COM"
  },
  "ConnectionStrings": {
    "AppDBConnection": "Data Source=.;Initial Catalog=CSULB_DB_Latest;Integrated Security=SSPI"
  },
  "Serilog": {
    "Using": [],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      //{
      //  "Name": "MSSqlServer"
      //},
      {
        "Name": "MSSqlServer",
        "Args": {
          "connectionString": "Data Source=.;Initial Catalog=CSULB_DB;Integrated Security=SSPI",
          "tableName": "Log",
          "schemaName": "Application"
        }
      }

    ],
    "Enrich": [
      "FromLogContext",
      "WithMachineName",
      "WithProcessId",
      "WithThreadId"
    ]

  }
}
