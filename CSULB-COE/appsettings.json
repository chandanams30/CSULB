{
  "Logging": {
    "LogLevel": {
      "Default": "Trace",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "AllowedHosts": "*",
  "JWT": {
    "Key": "This is my supper secret key for jwt",
    "Issuer": "http://CSULB.com",
    "Audience": "http://CSULB.com"
  },
  "TrackIncomingRequests": "True", // set to False when http tracking is not required 
  "ConnectionStrings": {
    "AppDBConnection": "Data Source=.;Initial Catalog=CSULB_DB;Integrated Security=SSPI"
  },
  "Serilog": {
    "Using": [],
    "MinimumLevel": {
      "Default": "Verbose",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [

      {
        "Name": "MSSqlServer",
        "Args": {
          "connectionString": "Data Source=.;Initial Catalog=CSULB_DB;Integrated Security=SSPI",
          "tableName": "Log",
          "schemaName": "Application",
          "restrictedToMinimumLevel": "Verbose"
        }
      }

    ],
    "Enrich": [
      "FromLogContext",
      "WithMachineName",
      "WithProcessId",
      "WithThreadId"
    ]

  },
  "ApplicationKeys": {
    "FileRepository": "<path>",
    "EmailDomainsNotToRegister": [ "gmail", "yahoo", "hotmail" ]
  }

}
